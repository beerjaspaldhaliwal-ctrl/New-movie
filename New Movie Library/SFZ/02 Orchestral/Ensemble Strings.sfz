// New Movie Library - Ensemble Strings
// Eight-player bowed ensemble: sustain (2 dynamics, 2 mics), tremolo, staccato, pizzicato, swell.
// Keyswitches: C0 Sustain, C#0 Tremolo, D0 Staccato, D#0 Pizzicato, E0 Swell
// Mod wheel (CC1) = dynamics of sustained articulations, CC11 = expression.
// Close + Hall microphones (Hall at -6 dB).
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.380
amplitude_oncc11=100

<master> sw_lokey=24 sw_hikey=28 sw_default=24
<group> sw_last=24 amp_veltrack=30 xfout_locc1=0 xfout_hicc1=127 xf_cccurve=power
