// New Movie Library - Cinematic Timpani
// Pitched timpani hits with 4 round robins and looped rolls with crescendo control.
// Keyswitches: C0 Hits, C#0 Roll
// Mod wheel (CC1) = dynamics of sustained articulations, CC11 = expression.
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.600
amplitude_oncc11=100

<master> sw_lokey=24 sw_hikey=25 sw_default=24
<group> sw_last=24 amp_veltrack=90 seq_length=4 seq_position=1 ampeg_release=0.25
<region> sample=Samples/02 Orchestral/Cinematic Timpani/HitRR1/Timpani_HitRR1_038_036_040_001_127.wav pitch_keycenter=38 lokey=36 hikey=40 lovel=1 hivel=127
