// New Movie Library - Concert Harp - Harp
// Plucked concert harp, 2 velocity layers x 2 round robins, rings out naturally.
// 2 velocity layer(s), 2 round robin(s)
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.500
amplitude_oncc11=100

<group> lovel=1 hivel=85 amp_veltrack=75 seq_length=2 seq_position=1
