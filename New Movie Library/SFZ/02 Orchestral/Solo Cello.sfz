// New Movie Library - Solo Cello
// Warm single cello with legato, staccato and pizzicato.
// Keyswitches: C0 Sustain, C#0 Staccato, D0 Pizzicato, D#0 Swell
// Mod wheel (CC1) = dynamics of sustained articulations, CC11 = expression.
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.320
amplitude_oncc11=100

<master> sw_lokey=24 sw_hikey=27 sw_default=24
<group> sw_last=24 amp_veltrack=30 xfout_locc1=0 xfout_hicc1=127 xf_cccurve=power
<region> sample=Samples/02 Orchestral/Solo Cello/SusP/SoloCello_SusP_036_036_039_001_127.wav pitch_keycenter=36 lokey=36 hikey=39 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=41895 loop_end=96979
