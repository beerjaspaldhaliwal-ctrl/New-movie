// New Movie Library - Woodwind Ensemble
// Breathy flute pair, clarinet pair and a woodwind staccato.
// Keyswitches: C0 Flute Sustain, C#0 Clarinet Sustain, D0 Staccato
// Mod wheel (CC1) = dynamics of sustained articulations, CC11 = expression.
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.250
amplitude_oncc11=100

<master> sw_lokey=24 sw_hikey=26 sw_default=24
<group> sw_last=24 amp_veltrack=30 amplitude_oncc1=100
<region> sample=Samples/02 Orchestral/Woodwind Ensemble/Flute/Woodwinds_Flute_048_040_051_001_127.wav pitch_keycenter=48 lokey=40 hikey=51 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=41895 loop_end=97597
