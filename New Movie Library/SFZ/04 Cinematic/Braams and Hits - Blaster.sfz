// New Movie Library - Braams and Hits - Blaster
// Trailer braams: brass-like saw walls and a ring-modulated, folded 'Blaster'.
// 1 velocity layer(s), 1 round robin(s)
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.900
amplitude_oncc11=100

<group> lovel=1 hivel=127 amp_veltrack=50
<region> sample=Samples/04 Cinematic/Braams and Hits/Blaster/Braams_Blaster_024_021_027_001_127.wav pitch_keycenter=24 lokey=21 hikey=27
<region> sample=Samples/04 Cinematic/Braams and Hits/Blaster/Braams_Blaster_030_028_033_001_127.wav pitch_keycenter=30 lokey=28 hikey=33
<region> sample=Samples/04 Cinematic/Braams and Hits/Blaster/Braams_Blaster_036_034_039_001_127.wav pitch_keycenter=36 lokey=34 hikey=39
<region> sample=Samples/04 Cinematic/Braams and Hits/Blaster/Braams_Blaster_042_040_045_001_127.wav pitch_keycenter=42 lokey=40 hikey=45
<region> sample=Samples/04 Cinematic/Braams and Hits/Blaster/Braams_Blaster_048_046_060_001_127.wav pitch_keycenter=48 lokey=46 hikey=60
