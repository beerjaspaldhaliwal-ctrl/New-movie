// New Movie Library - Tension Toolkit
// Suspense tools: clock, heartbeat and pulse loops, scrapes, clusters, stingers, breaths.
// Key map: C1 Clock Loop, C#1 Heartbeat Loop, D1 Sub Pulse Loop, D#1 Ticking Bomb, E1 String Scrape, F1 Col Legno, F#1 Bowed Cymbal, G1 Piano Cluster, G#1 Stinger High, A1 Stinger Low, A#1 Breath, B1 Metal Creak
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.250
amplitude_oncc11=100


// C1 Clock Loop
<region> sample=Samples/04 Cinematic/Tension Toolkit/FX/TensionKit_FX_036_036_036_001_127.wav key=36 pitch_keycenter=36 lovel=1 hivel=127 amp_veltrack=85 loop_mode=loop_continuous loop_start=44100 loop_end=132299

