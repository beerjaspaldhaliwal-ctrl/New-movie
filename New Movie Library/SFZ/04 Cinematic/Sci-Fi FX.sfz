// New Movie Library - Sci-Fi FX
// Eighteen sci-fi effects: lasers, alarms, robots, data, teleports, ships and warps.
// Key map: C1 Laser Zap, C#1 Laser Burst, D1 Phaser Blast, D#1 Alarm, E1 Robot Beeps, F1 Data Stream, F#1 Teleport, G1 Power Up, G#1 Shutdown, A1 Force Field, A#1 Servo, B1 Ship Pass, C2 Sonar Ping, C#2 Radio Static, D2 Energy Charge, D#2 Zap Hit, E2 Alien Voice, F2 Warp
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.250
amplitude_oncc11=100


// C1 Laser Zap
<region> sample=Samples/04 Cinematic/Sci-Fi FX/FX/SciFi_FX_036_036_036_001_127.wav key=36 pitch_keycenter=36 lovel=1 hivel=127 amp_veltrack=85 loop_mode=one_shot

