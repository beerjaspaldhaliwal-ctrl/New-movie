// New Movie Library - Dark Atmospheres (Abyss + MachineHum)
// Eight dark beds: abyss, wind, bowed metal, haunted choir, machine hum, deep space, pulse, shimmer.
// The default blend of the two layers.
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=1.800 ampeg_release=4.000
amplitude_oncc11=100

<group> amp_veltrack=10 volume=-1.0
<region> sample=Samples/04 Cinematic/Dark Atmospheres/Abyss/DarkAtmos_Abyss_048_024_096_001_127.wav pitch_keycenter=48 lokey=24 hikey=96 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=61739 loop_end=206876
<group> amp_veltrack=10 volume=-6.9
<region> sample=Samples/04 Cinematic/Dark Atmospheres/MachineHum/DarkAtmos_MachineHum_048_024_096_001_127.wav pitch_keycenter=48 lokey=24 hikey=96 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=61739 loop_end=207038
