// New Movie Library - Hybrid Trailer Percussion
// Hybrid trailer percussion: booms, slams, distorted toms, chains and glitch hits.
// Key map: C1 Epic Boom, C#1 Distorted Kick, D1 Hybrid Hit, D#1 Metal Slam, E1 Taiko Stack, F1 Dist Tom Low, G1 Dist Tom Mid, A1 Dist Tom High, F#1 Clap Stack, G#1 Snap Snare, A#1 Chain Slam, B1 Sub Hit, C2 Gong Hit, C#2 Whip Crack, D2 Glitch Hit, D#2 Rumble Hit
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.250
amplitude_oncc11=100


// C1 Epic Boom
<region> sample=Samples/04 Cinematic/Hybrid Trailer Percussion/RR1/TrailerPerc_RR1_036_036_036_001_127.wav key=36 pitch_keycenter=36 lovel=1 hivel=127 amp_veltrack=85 lorand=0.000 hirand=0.500 loop_mode=one_shot
