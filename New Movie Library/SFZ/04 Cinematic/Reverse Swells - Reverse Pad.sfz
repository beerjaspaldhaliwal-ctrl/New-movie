// New Movie Library - Reverse Swells - Reverse Pad
// Chromatic reversed piano, strings and pad swells for transitions.
// 1 velocity layer(s), 1 round robin(s)
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.300
amplitude_oncc11=100

<group> lovel=1 hivel=127 amp_veltrack=50
<region> sample=Samples/04 Cinematic/Reverse Swells/RevPad/ReverseSwells_RevPad_036_024_042_001_127.wav pitch_keycenter=36 lokey=24 hikey=42
<region> sample=Samples/04 Cinematic/Reverse Swells/RevPad/ReverseSwells_RevPad_048_043_054_001_127.wav pitch_keycenter=48 lokey=43 hikey=54
<region> sample=Samples/04 Cinematic/Reverse Swells/RevPad/ReverseSwells_RevPad_060_055_066_001_127.wav pitch_keycenter=60 lokey=55 hikey=66
<region> sample=Samples/04 Cinematic/Reverse Swells/RevPad/ReverseSwells_RevPad_072_067_078_001_127.wav pitch_keycenter=72 lokey=67 hikey=78
<region> sample=Samples/04 Cinematic/Reverse Swells/RevPad/ReverseSwells_RevPad_084_079_096_001_127.wav pitch_keycenter=84 lokey=79 hikey=96
