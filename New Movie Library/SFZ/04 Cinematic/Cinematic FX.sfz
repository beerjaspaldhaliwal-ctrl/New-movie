// New Movie Library - Cinematic FX
// Twenty trailer-style one-shots: impacts, risers, whooshes, downers and stingers.
// Key map: C1 Boom Impact, C#1 Sub Drop, D1 Trailer Hit, D#1 Metal Impact, E1 Low Hit, F1 Glass Hit, F#1 Noise Riser, G1 Tonal Riser, G#1 Tension Riser, A1 Reverse Cymbal, A#1 Reverse Hit, B1 Whoosh Fast, C2 Whoosh Slow, C#2 Downer, D2 Power Down, D#2 Braam Stab, E2 Heartbeat, F2 Clock Ticks, F#2 Glitch Stutter, G2 Distant Thunder
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.250
amplitude_oncc11=100


// C1 Boom Impact
<region> sample=Samples/04 Cinematic/Cinematic FX/FX/FX_FX_036_036_036_001_127.wav key=36 pitch_keycenter=36 lovel=1 hivel=127 amp_veltrack=85 loop_mode=one_shot

