// New Movie Library - Sitar and Tanpura - Tanpura Drone
// Sitar with buzzing jawari bridge and sympathetic strings, plus a looping tanpura drone.
// 1 velocity layer(s), 1 round robin(s)
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.400
amplitude_oncc11=100

<group> lovel=1 hivel=127 amp_veltrack=75
<region> sample=Samples/05 World/Sitar and Tanpura/Tanpura/Sitar_Tanpura_048_024_096_001_127.wav pitch_keycenter=48 lokey=24 hikey=96 loop_mode=loop_continuous loop_start=70560 loop_end=211679
