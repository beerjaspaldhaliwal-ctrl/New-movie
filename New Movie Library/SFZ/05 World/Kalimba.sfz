// New Movie Library - Kalimba - Kalimba
// Thumb piano tines on a wooden resonator box.
// 1 velocity layer(s), 2 round robin(s)
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.300
amplitude_oncc11=100

<group> lovel=1 hivel=127 amp_veltrack=75 seq_length=2 seq_position=1
<region> sample=Samples/05 World/Kalimba/RR1/Kalimba_RR1_055_050_058_001_127.wav pitch_keycenter=55 lokey=50 hikey=58
