// New Movie Library - Duduk
// Mournful double-reed flute in the duduk style, with legato slides.
// Keyswitches: C0 Sustain, C#0 Staccato, D0 Swell
// Mod wheel (CC1) = dynamics of sustained articulations, CC11 = expression.
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.300
amplitude_oncc11=100

<master> sw_lokey=24 sw_hikey=26 sw_default=24
<group> sw_last=24 amp_veltrack=30 amplitude_oncc1=100
<region> sample=Samples/05 World/Duduk/Sus/Duduk_Sus_052_048_055_001_127.wav pitch_keycenter=52 lokey=48 hikey=55 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=41895 loop_end=96527
