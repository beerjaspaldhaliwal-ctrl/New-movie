// New Movie Library - Synthwave Kit
// 80s drum machine kit with gated snares, Simmons-style toms and cowbell.
// Key map: C1 Kick, C#1 Rim, D1 Gated Snare, D#1 Gated Clap, E1 Snare 2, F1 Tom 1, G1 Tom 2, A1 Tom 3, B1 Tom 4, C2 Tom 5, F#1 Closed Hat, G#1 Pedal Hat, A#1 Open Hat, C#2 Crash, D#2 Ride, F#2 Tambourine, G#2 Cowbell
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.250
amplitude_oncc11=100


