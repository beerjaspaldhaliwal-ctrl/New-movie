// New Movie Library - Studio Drum Kit
// Synthesised acoustic/hybrid kit: 20 pieces, 3 velocity layers x 3 round robins.
// Key map: C1 Kick, C#1 Side Stick, D1 Snare, D#1 Clap, E1 Rimshot, F1 Floor Tom 2, F#1 Closed Hat, G1 Floor Tom 1, G#1 Pedal Hat, A1 Low Tom, A#1 Open Hat, B1 Mid Tom, C2 Hi-Mid Tom, C#2 Crash, D2 High Tom, D#2 Ride, F2 Ride Bell, F#2 Tambourine, A2 Crash 2, A#3 Shaker
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.250
amplitude_oncc11=100


