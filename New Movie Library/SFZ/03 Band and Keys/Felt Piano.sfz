// New Movie Library - Felt Piano - Felt Piano
// Physically modelled felt piano: hammer, 1-3 strings per note and a soundboard.
// 3 velocity layer(s), 1 round robin(s)
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.250
amplitude_oncc11=100

<group> lovel=1 hivel=50 amp_veltrack=75
