// New Movie Library - Cinematic Mallets - Vibraphone
// Modal-synthesis marimba, vibraphone, celesta and glockenspiel.
// 1 velocity layer(s), 1 round robin(s)
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.400
amplitude_oncc11=100

<group> lovel=1 hivel=127 amp_veltrack=75
