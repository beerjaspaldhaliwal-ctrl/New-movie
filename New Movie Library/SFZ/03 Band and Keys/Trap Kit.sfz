// New Movie Library - Trap Kit
// Modern trap kit: long 808, snares, claps, hats with Note Repeat rolls, percs and vox.
// Key map: C1 808 Kick, B0 Punch Kick, D1 Trap Snare, D#1 Clap, E1 Snare + Clap, C#1 Rim, F#1 Hat, G#1 Hat Tight, A#1 Open Hat, C#2 Crash, D#2 Perc Bell, E2 Snap, F2 Shaker, G2 Vox Chop
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.250
amplitude_oncc11=100


