// New Movie Library - Analog Mono Bass (Growl)
// Pure sub and a resonant, driven growl layer. Mono legato with glide.
// Range C-1-C4
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.002 ampeg_release=0.140
amplitude_oncc11=100

