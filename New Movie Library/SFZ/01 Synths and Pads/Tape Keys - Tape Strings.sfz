// New Movie Library - Tape Keys - Tape Strings
// Tape-replay keyboard: flute, strings and choir with wow, flutter and hiss.
// 1 velocity layer(s), 1 round robin(s)
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.010 ampeg_release=0.400
amplitude_oncc11=100

<group> lovel=1 hivel=127 amp_veltrack=50
