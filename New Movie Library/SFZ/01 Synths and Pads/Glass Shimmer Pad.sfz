// New Movie Library - Glass Shimmer Pad (Glass)
// FM glass bells with an octave shimmer, chorus and a long hall.
// Range C0-C7
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
