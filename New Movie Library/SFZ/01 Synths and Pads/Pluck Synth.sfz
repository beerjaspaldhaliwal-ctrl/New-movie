// New Movie Library - Pluck Synth - Pluck
// Snappy filter-envelope pluck with three round robins.
// 1 velocity layer(s), 3 round robin(s)
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.300
amplitude_oncc11=100

<group> lovel=1 hivel=127 amp_veltrack=75 seq_length=3 seq_position=1
