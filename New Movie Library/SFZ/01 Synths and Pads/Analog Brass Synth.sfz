// New Movie Library - Analog Brass Synth (Brass)
// Classic polysynth brass: detuned saws with a swelling filter envelope.
// Range C0-C7
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.005 ampeg_release=0.350
amplitude_oncc11=100

<group> amp_veltrack=55
