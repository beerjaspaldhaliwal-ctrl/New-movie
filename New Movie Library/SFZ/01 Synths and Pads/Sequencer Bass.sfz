// New Movie Library - Sequencer Bass - Seq Bass
// Punchy resonant sequence bass, arpeggiator on by default.
// 1 velocity layer(s), 1 round robin(s)
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.120
amplitude_oncc11=100

<group> lovel=1 hivel=127 amp_veltrack=50
<region> sample=Samples/01 Synths and Pads/Sequencer Bass/Seq/SeqBass_Seq_024_012_027_001_127.wav pitch_keycenter=24 lokey=12 hikey=27
