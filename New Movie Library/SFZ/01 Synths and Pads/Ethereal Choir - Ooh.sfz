// New Movie Library - Ethereal Choir (Ooh)
// Formant-synthesised mixed choir, Aah and Ooh vowels, morphable.
// Range A0-C6
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.380 ampeg_release=1.600
amplitude_oncc11=100

<group> amp_veltrack=25
