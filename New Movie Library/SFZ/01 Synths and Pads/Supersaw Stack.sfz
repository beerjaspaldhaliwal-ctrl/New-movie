// New Movie Library - Supersaw Stack (Saw)
// Seven detuned saws, trance/trailer style. Poly, or mono with glide.
// Range C0-C7
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.003 ampeg_release=0.380
amplitude_oncc11=100

<group> amp_veltrack=40
