// New Movie Library - Wavetable Pad (Digital)
// Slowly morphing wavetable pad plus a wavefolded digital layer.
// Range C0-C7
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.400 ampeg_release=1.800
amplitude_oncc11=100

<group> amp_veltrack=30
