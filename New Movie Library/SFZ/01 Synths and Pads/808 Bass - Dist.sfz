// New Movie Library - 808 Bass (Dist)
// Long trap 808 with pitch punch; clean and distorted layers, mono slide.
// Range C-1-C4
// Generated by tools/nml/formats.py. Samples: ../../Samples (keep the library folder intact).

<control>
default_path=../../
set_cc1=90
set_cc11=127

<global>
ampeg_attack=0.000 ampeg_release=0.200
amplitude_oncc11=100

<group> amp_veltrack=40
<region> sample=Samples/01 Synths and Pads/808 Bass/Dist/Bass808_Dist_024_012_027_001_127.wav pitch_keycenter=24 lokey=12 hikey=27 lovel=1 hivel=127
<region> sample=Samples/01 Synths and Pads/808 Bass/Dist/Bass808_Dist_030_028_033_001_127.wav pitch_keycenter=30 lokey=28 hikey=33 lovel=1 hivel=127
<region> sample=Samples/01 Synths and Pads/808 Bass/Dist/Bass808_Dist_036_034_039_001_127.wav pitch_keycenter=36 lokey=34 hikey=39 lovel=1 hivel=127
<region> sample=Samples/01 Synths and Pads/808 Bass/Dist/Bass808_Dist_042_040_045_001_127.wav pitch_keycenter=42 lokey=40 hikey=45 lovel=1 hivel=127
<region> sample=Samples/01 Synths and Pads/808 Bass/Dist/Bass808_Dist_048_046_051_001_127.wav pitch_keycenter=48 lokey=46 hikey=51 lovel=1 hivel=127
<region> sample=Samples/01 Synths and Pads/808 Bass/Dist/Bass808_Dist_054_052_057_001_127.wav pitch_keycenter=54 lokey=52 hikey=57 lovel=1 hivel=127
